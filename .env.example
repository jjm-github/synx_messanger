# База synx engine (пользователи, личные сообщения, аудио-комнаты)
SYNX_DB_DSN=postgresql://synx:synx@127.0.0.1:5432/synx_engine

# Кука называется так же, как в synx engine: на одном домене вход общий.
# Для локального http поставьте false.
SYNX_SESSION_HOURS=12
SYNX_COOKIE_SECURE=false

# Файлы: аватары и вложения личных сообщений лежат в хранилище движка.
SYNX_STORAGE_PATH=/var/lib/synx_engine/files
#SYNX_VERSIONS_ROOT=/srv/synx/versions
#SYNX_PROJECTS_ROOT=/srv/synx/projects

SYNX_DB_POOL_MIN=2
SYNX_DB_POOL_MAX=20
SYNX_DM_RETENTION_DAYS=14

# TCP/WebSocket-микшер аудио. Если рядом уже работает synx engine,
# оставьте 8011 — мессенджер будет использовать его микшер.
SYNX_AUDIO_HOST=127.0.0.1
SYNX_AUDIO_PORT=8011
SYNX_AUDIO_MIX_RATE=16000
